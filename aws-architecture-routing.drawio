        </mxCell>

        <mxCell id="flow1" value="• DNS (Route 53) resolves domain to ALB DNS name" style="text;html=1;strokeColor=#232F3E;fillColor=#F5F5F5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
