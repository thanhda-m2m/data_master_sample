        </mxCell>

        <mxCell id="flow3" value="• Target Group 1 (port 3000) → App 1; Target Group 2 (port 4000) → App 2" style="text;html=1;strokeColor=#232F3E;fillColor=#F5F5F5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
