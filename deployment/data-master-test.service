# /etc/systemd/system/data-master-test.service
[Unit]
Description=Data Master Test
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/var/www/data_master_sample_test
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
